{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "strict": false,
    "allowJs": true,
    "skipLibCheck": true,
    "jsx": "preserve"
  },
  "include": ["src/**/*"]
}
